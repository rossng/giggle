#!/usr/bin/env bash
# Run a command with giggle's secrets in its environment, decrypted by sops from the private
# giggle-secrets repo (cloned next to this one, or GIGGLE_SECRETS=<path to giggle.env>) with this
# machine's age key. Nothing is written to disk. Without that file, run the command as is: the
# pipeline still reads a local .env if there is one. Setup: the giggle-secrets README.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
secrets=${GIGGLE_SECRETS:-$root/../giggle-secrets/giggle.env}

if [[ ! -f $secrets ]]; then
	echo "with-secrets: $secrets not found; running without it (.env, if any)" >&2
	exec "$@"
fi
# sops runs the command through a shell, so quote each argument for it.
exec sops exec-env "$secrets" "$(printf '%q ' "$@")"
