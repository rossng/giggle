// giggle's Worker: serves the static SPA (web/build) and the per-user API under /api/*.
//
// The top level is PRODUCTION: people sign in with passkeys bound to PASSKEY_RP_ID (the site's
// hostname), from SITE_ORIGINS only (src/config.ts).
//
// `env.dev` is for `wrangler dev --env dev` only (make worker-dev): ENVIRONMENT=dev, passkeys on
// localhost, and a fake identity from the X-Giggle-Dev-User header or giggle_dev_user cookie,
// honoured only on loopback hostnames. The Worker refuses ENVIRONMENT=dev with any PASSKEY_RP_ID
// but localhost. Never deploy with --env dev.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "giggle",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": { "enabled": true },
	"send_metrics": false,

	"assets": {
		"directory": "../web/build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/models/*"]
	},

	"vars": {
		"ENVIRONMENT": "production",
		// Passkeys only work on this hostname: moving the site means registering them again.
		"PASSKEY_RP_ID": "giggle.rossng.workers.dev",
		"SITE_ORIGINS": "https://giggle.rossng.workers.dev"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "giggle",
			// From `wrangler d1 create giggle` (WEUR); not a secret.
			"database_id": "a1681d28-13ef-4de0-8cf0-f53eb0c6112b",
			"migrations_dir": "migrations"
		}
	],

	// The browser's Kokoro model files, served at /models/* (src/models.ts). Create it once with
	// `wrangler r2 bucket create giggle-models` and fill it with `node scripts/models.mjs put
	// --remote` (README.md → Model files).
	"r2_buckets": [{ "binding": "MODELS", "bucket_name": "giggle-models" }],

	"env": {
		"dev": {
			"assets": {
				"directory": "../web/build",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": ["/api/*", "/models/*"]
			},
			"vars": {
				"ENVIRONMENT": "dev",
				// vite dev (make dev) and wrangler dev itself.
				"PASSKEY_RP_ID": "localhost",
				"SITE_ORIGINS": "http://localhost:5173 http://localhost:8787"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "giggle-dev",
					"database_id": "00000000-0000-0000-0000-00000000de00",
					"migrations_dir": "migrations"
				}
			],
			// Local only (worker/.wrangler/): `make models` fills it.
			"r2_buckets": [{ "binding": "MODELS", "bucket_name": "giggle-models-dev" }]
		}
	}
}
