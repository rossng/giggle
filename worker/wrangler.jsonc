// giggle's Worker: serves the static SPA (web/build) and the per-user API under /api/*.
//
// The top level is PRODUCTION. Cloudflare Access protects /api/* on the production hostname;
// the Worker verifies the Cf-Access-Jwt-Assertion JWT against ACCESS_TEAM_DOMAIN/ACCESS_AUD
// and refuses to serve /api/* until both are set.
//
// `env.dev` is for `wrangler dev --env dev` only (make worker-dev): ENVIRONMENT=dev, no Access
// config, and a fake identity from the X-Giggle-Dev-User header or giggle_dev_user cookie, honoured
// only on loopback hostnames. The Worker refuses to serve /api/* if ENVIRONMENT=dev and the
// Access vars are set at the same time. Never deploy with --env dev.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "giggle",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": { "enabled": true },
	"send_metrics": false,

	"assets": {
		"directory": "../web/build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/models/*"]
	},

	"vars": {
		"ENVIRONMENT": "production",
		// Fill in before deploying: the Zero Trust team domain and the Access application's
		// AUD tag (Zero Trust → Access → Applications → giggle API → Overview).
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "giggle",
			// From `wrangler d1 create giggle` (WEUR); not a secret.
			"database_id": "a1681d28-13ef-4de0-8cf0-f53eb0c6112b",
			"migrations_dir": "migrations"
		}
	],

	// The browser's Kokoro model files, served at /models/* (src/models.ts). Create it once with
	// `wrangler r2 bucket create giggle-models` and fill it with `node scripts/models.mjs put
	// --remote` (README.md → Model files).
	"r2_buckets": [{ "binding": "MODELS", "bucket_name": "giggle-models" }],

	"env": {
		"dev": {
			"assets": {
				"directory": "../web/build",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": ["/api/*", "/models/*"]
			},
			"vars": {
				"ENVIRONMENT": "dev",
				// Must stay empty: the Worker refuses to serve if dev and Access are both configured.
				"ACCESS_TEAM_DOMAIN": "",
				"ACCESS_AUD": ""
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "giggle-dev",
					"database_id": "00000000-0000-0000-0000-00000000de00",
					"migrations_dir": "migrations"
				}
			],
			// Local only (worker/.wrangler/): `make models` fills it.
			"r2_buckets": [{ "binding": "MODELS", "bucket_name": "giggle-models-dev" }]
		}
	}
}
